{
  "name": "scholar-rank",
  "version": "1.2.1",
  "private": true,
  "description": "Chrome 扩展：在 Google Scholar 显示 CCF、中科院、ABDC、ABS/AJG、UTD24、FT50、Nature Index 等评级",
  "type": "module",
  "scripts": {
    "build": "npm run build:ccf && npm run build:core && npm run build:journals && npm run build:icons",
    "build:ccf": "node tools/build-ccf.mjs",
    "build:core": "node tools/build-core.mjs",
    "build:journals": "node tools/build-journals.mjs",
    "build:icons": "node tools/make-icons.mjs",
    "test": "node tools/selftest.mjs",
    "test:browser": "node tools/browser-test.mjs",
    "vendor:screenshot": "node tools/vendor-screenshot.mjs",
    "probe": "node tools/lookup.mjs",
    "serve": "node tools/serve.mjs"
  },
  "devDependencies": {
    "html2canvas": "^1.4.1",
    "playwright-core": "^1.64.1"
  }
}
